# ── Factory Frontend — Production Environment Variables ───────────────────────
# Copy to .env.production and set real values. Never commit real values.
# All NEXT_PUBLIC_ vars are exposed to the browser — no secrets here.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Railway API base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://your-api.railway.app

# Preview gateway base URL (Railway)
NEXT_PUBLIC_PREVIEW_BASE_URL=https://your-preview.railway.app

# App environment identifier
NEXT_PUBLIC_APP_ENV=production

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Enable analytics (default: false)
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Enable beta features (default: false)
NEXT_PUBLIC_BETA_MODE=false

# Netlify site URL (injected automatically by Netlify)
# NEXT_PUBLIC_NETLIFY_SITE_URL=https://your-site.netlify.app

# Error monitoring (safe to leave empty)
NEXT_PUBLIC_SENTRY_DSN=

# ── LEGACY ALIASES (supported for backward compat) ────────────────────────────
# These will be read if NEXT_PUBLIC_API_BASE_URL is not set.
# Migrate to NEXT_PUBLIC_API_BASE_URL as canonical name.
# NEXT_PUBLIC_PROD_API_BASE=https://your-api.railway.app
# NEXT_PUBLIC_API_URL=https://your-api.railway.app

# ── NODE ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
