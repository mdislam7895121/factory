# Database
DATABASE_URL="postgresql://USER:PASS@localhost:5432/DB?schema=public"

# API Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
WEB_URL=

# Redis (required for distributed rate limiting, scheduler lock, and coordination layer)
# Use Redis or Valkey. Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=factory
REDIS_RUNTIME_TTL_SEC=300
REDIS_PREVIEW_TTL_SEC=300
REDIS_WS_TTL_SEC=120

# Security hardening
AUTH_SECRET=YOUR_STRONG_SECRET_HERE
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_HEALTH_MAX=240
BODY_LIMIT=1mb
DEBUG_TOKEN=

# Distributed scheduler lock TTL (seconds). Must be > tick interval (60s).
LOOP_LOCK_TTL_SEC=120

# Optional: set to a unique string per pod (e.g. Railway ${{RAILWAY_REPLICA_ID}})
# Used to identify which instance holds the scheduler lock.
INSTANCE_ID=

# Optional: Error monitoring metadata
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ── SERIAL 04: Detached Runtime Cloud ────────────────────────────────────────
# How often the health scheduler ticks (ms). Default 30s.
RUNTIME_HEALTH_INTERVAL_MS=30000
# Seconds of heartbeat silence before a RUNNING runtime is marked CRASHED. Default 90s.
RUNTIME_HEARTBEAT_DEAD_SEC=90
# Seconds of inactivity before a RUNNING runtime transitions to IDLE. Default 5 min.
RUNTIME_IDLE_TTL_SEC=300
# Seconds of IDLE before transitioning to SLEEPING. Default 30 min.
RUNTIME_SLEEP_TTL_SEC=1800
# Enable automatic container recovery after crash (up to 3 attempts). Default true.
AUTO_RECOVERY_ENABLED=true
# Base URL for stable preview URLs assigned to each runtime. Never changes after creation.
PREVIEW_PUBLIC_BASE_URL=http://localhost:3000
# Orchestrator URL for container lifecycle operations.
ORCHESTRATOR_URL=http://localhost:4100
# Shared API key for orchestrator → API auth.
ORCHESTRATOR_API_KEY=CHANGE_ME_orchestrator_api_key

# ── SERIAL 05: Public Preview Gateway ────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREVIEW_SHARE_SECRET=CHANGE_ME_preview_share_secret_32_hex
# How long to retain preview access logs (days). Default 30.
PREVIEW_LOG_RETENTION_DAYS=30
# How long to wait for a sleeping runtime to wake on request (ms). Default 30s.
PREVIEW_GATEWAY_WAKE_TIMEOUT_MS=30000

# Add other environment variables here
