# Database
DATABASE_URL="postgresql://USER:PASS@localhost:5432/DB?schema=public"

# API Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
WEB_URL=

# Redis (required for distributed rate limiting, scheduler lock, and coordination layer)
# Use Redis or Valkey. Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=factory
REDIS_RUNTIME_TTL_SEC=300
REDIS_PREVIEW_TTL_SEC=300
REDIS_WS_TTL_SEC=120

# Security hardening
AUTH_SECRET=YOUR_STRONG_SECRET_HERE
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_HEALTH_MAX=240
BODY_LIMIT=1mb
DEBUG_TOKEN=

# Distributed scheduler lock TTL (seconds). Must be > tick interval (60s).
LOOP_LOCK_TTL_SEC=120

# Optional: set to a unique string per pod (e.g. Railway ${{RAILWAY_REPLICA_ID}})
# Used to identify which instance holds the scheduler lock.
INSTANCE_ID=

# Optional: Error monitoring metadata
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ── SERIAL 04: Detached Runtime Cloud ────────────────────────────────────────
# How often the health scheduler ticks (ms). Default 30s.
RUNTIME_HEALTH_INTERVAL_MS=30000
# Seconds of heartbeat silence before a RUNNING runtime is marked CRASHED. Default 90s.
RUNTIME_HEARTBEAT_DEAD_SEC=90
# Seconds of inactivity before a RUNNING runtime transitions to IDLE. Default 5 min.
RUNTIME_IDLE_TTL_SEC=300
# Seconds of IDLE before transitioning to SLEEPING. Default 30 min.
RUNTIME_SLEEP_TTL_SEC=1800
# Enable automatic container recovery after crash (up to 3 attempts). Default true.
AUTO_RECOVERY_ENABLED=true
# Base URL for stable preview URLs assigned to each runtime. Never changes after creation.
PREVIEW_PUBLIC_BASE_URL=http://localhost:3000
# Orchestrator URL for container lifecycle operations.
ORCHESTRATOR_URL=http://localhost:4100
# Shared API key for orchestrator → API auth.
ORCHESTRATOR_API_KEY=CHANGE_ME_orchestrator_api_key

# ── SERIAL 05: Public Preview Gateway ────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREVIEW_SHARE_SECRET=CHANGE_ME_preview_share_secret_32_hex
# How long to retain preview access logs (days). Default 30.
PREVIEW_LOG_RETENTION_DAYS=30
# How long to wait for a sleeping runtime to wake on request (ms). Default 30s.
PREVIEW_GATEWAY_WAKE_TIMEOUT_MS=30000

# ── SERIAL 06: Remix / Fork Engine ───────────────────────────────────────────
# Max remix operations per user per hour. Default 10.
REMIX_MAX_PER_HOUR=10
# Max remix operations per IP per hour. Default 20.
REMIX_MAX_IP_PER_HOUR=20
# How often the remix queue scheduler ticks (ms). Default 15s.
REMIX_QUEUE_INTERVAL_MS=15000

# ── SERIAL 10: Public Beta Launch Gate ───────────────────────────────────────

# Admin API key — required for /admin/* endpoints and kill switch control.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=CHANGE_ME_admin_api_key_strong_secret

# Kill switches — set to '1' to enable. Can also be toggled dynamically via admin API.
# KILL_SWITCH_RUNTIME_CREATE=0
# KILL_SWITCH_PREVIEWS=0
# KILL_SWITCH_REMIX=0
# KILL_SWITCH_MAINTENANCE=0
# KILL_SWITCH_READONLY=0

# Preview abuse guard
ABUSE_PREVIEW_DAILY_LIMIT=500
ABUSE_PREVIEW_BAN_THRESHOLD=1000
ABUSE_BAN_TTL_SEC=3600

# Runtime quotas (free tier)
QUOTA_MAX_RUNTIMES_PER_USER=5
QUOTA_MAX_ACTIVE_RUNTIMES=2
QUOTA_MAX_REMIX_PER_DAY=20

# Beta access control
# BETA_MODE: open | invite | waitlist | closed. Default: open.
BETA_MODE=open
# INVITE_ONLY=false shorthand for BETA_MODE=invite
INVITE_ONLY=false
# PUBLIC_SIGNUP_ENABLED: false to block all new signups. Default: depends on BETA_MODE.
PUBLIC_SIGNUP_ENABLED=true

# Stripe (only required when STRIPE_ENABLED=true)
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── SERIAL 09: Mobile Viral Preview Experience ───────────────────────────────
# Max abuse reports per IP per hour. Default 5.
REPORT_MAX_PER_IP_HOUR=5

# ── SERIAL 08: Persistent Snapshots + Recovery ───────────────────────────────
# Enable automatic snapshot-based restore when a runtime crashes. Default false (manual only).
AUTO_RESTORE_ENABLED=false
# Maximum auto-restore attempts per runtime before giving up. Default 2.
AUTO_RESTORE_MAX_ATTEMPTS=2
# Retention window for manually-created snapshots (days). Default 90.
SNAPSHOT_MANUAL_RETENTION_DAYS=90
# Retention window for auto-created snapshots (days). Default 14.
SNAPSHOT_AUTO_RETENTION_DAYS=14
# Maximum number of READY snapshots to keep per project. Default 25.
SNAPSHOT_MAX_PER_PROJECT=25

# ── SERIAL 07: Live AI Company Stream ────────────────────────────────────────
# How often the activity monitor polls for runtime state changes (ms). Default 30s.
ACTIVITY_MONITOR_INTERVAL_MS=30000
# Event retention windows per severity (days).
ACTIVITY_RETENTION_INFO_DAYS=7
ACTIVITY_RETENTION_WARNING_DAYS=14
ACTIVITY_RETENTION_ERROR_DAYS=30
ACTIVITY_RETENTION_CRITICAL_DAYS=90

# ── SERIAL 11: Magic Demo Flow ────────────────────────────────────────────────
# Optional: a pre-provisioned RuntimeInstance ID to embed in the demo reveal.
# If set, the reveal panel shows the real running app via /p/:id/shell.
# DEMO_RUNTIME_ID=

# Add other environment variables here
