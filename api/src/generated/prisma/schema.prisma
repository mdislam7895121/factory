generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}

model Template {
  id          String   @id
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

enum ProjectStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

enum ProvisioningRunStatus {
  RUNNING
  READY
  FAILED
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  ownerId     String?
  ownerUserId String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([ownerId])
  @@index([ownerUserId])
}

model Project {
  id                    String            @id @default(uuid())
  workspaceId           String
  name                  String
  slug                  String?
  templateId            String
  orchestratorProjectId String?
  status                ProjectStatus     @default(QUEUED)
  isActive              Boolean           @default(true)
  previewUrl            String?
  logsRef               String?
  provisionError        String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provisioningRuns      ProvisioningRun[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ProvisioningRun {
  id         String                @id @default(uuid())
  projectId  String
  status     ProvisioningRunStatus
  error      String?
  createdAt  DateTime              @default(now())
  startedAt  DateTime              @default(now())
  finishedAt DateTime?
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PublicProject {
  id          String   @id @default(uuid())
  ownerId     String
  templateId  String
  repoUrl     String?
  status      String
  previewUrl  String?
  containerId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  apiKeys       ApiKey[]
  sandboxes     Sandbox[]
  agentMemories AgentMemory[]
  agentEvents   AgentEvent[]
}

enum SandboxLanguage {
  python
  nodejs
  bash
}

enum SandboxStatus {
  CREATING
  READY
  RUNNING
  TERMINATED
  FAILED
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  keyHash    String    @unique
  keyPrefix  String
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model Sandbox {
  id           String          @id @default(uuid())
  userId       String
  language     SandboxLanguage
  status       SandboxStatus   @default(CREATING)
  containerId  String?
  port         Int?
  timeoutSecs  Int             @default(300)
  startedAt    DateTime?
  terminatedAt DateTime?
  createdAt    DateTime        @default(now())
  usageLogs    UsageLog[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model UsageLog {
  id           String   @id @default(uuid())
  sandboxId    String
  userId       String
  durationSecs Int
  billedAmount Float
  language     String
  createdAt    DateTime @default(now())
  sandbox      Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sandboxId])
  @@index([createdAt])
}

// Agent memory: persistent key-value store scoped by user + namespace
// namespace = agent role (architect, dev, qa, security, monitor, healer, shared)
model AgentMemory {
  id        String    @id @default(uuid())
  userId    String
  namespace String
  key       String
  value     String // JSON-encoded value
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, namespace, key])
  @@index([userId, namespace])
  @@index([expiresAt])
}

// Agent event log: immutable append-only decisions/actions record
model AgentEvent {
  id        String   @id @default(uuid())
  userId    String
  namespace String
  eventType String // e.g. "decision", "action", "observation", "error"
  payload   String // JSON-encoded
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, namespace])
  @@index([userId, createdAt])
}
