generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}

model Template {
  id          String   @id
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

enum ProjectStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

enum ProvisioningRunStatus {
  RUNNING
  READY
  FAILED
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  ownerId     String?
  ownerUserId String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([ownerId])
  @@index([ownerUserId])
}

model Project {
  id                    String            @id @default(uuid())
  workspaceId           String
  name                  String
  slug                  String?
  templateId            String
  orchestratorProjectId String?
  status                ProjectStatus     @default(QUEUED)
  isActive              Boolean           @default(true)
  previewUrl            String?
  logsRef               String?
  provisionError        String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provisioningRuns      ProvisioningRun[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ProvisioningRun {
  id         String                @id @default(uuid())
  projectId  String
  status     ProvisioningRunStatus
  error      String?
  createdAt  DateTime              @default(now())
  startedAt  DateTime              @default(now())
  finishedAt DateTime?
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PublicProject {
  id          String   @id @default(uuid())
  ownerId     String
  templateId  String
  repoUrl     String?
  status      String
  previewUrl  String?
  containerId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  apiKeys         ApiKey[]
  sandboxes       Sandbox[]
  agentMemories   AgentMemory[]
  agentEvents     AgentEvent[]
  councilSessions CouncilSession[]
  loopConfigs     LoopConfig[]
}

enum SandboxLanguage {
  python
  nodejs
  bash
}

enum SandboxStatus {
  CREATING
  READY
  RUNNING
  TERMINATED
  FAILED
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  keyHash    String    @unique
  keyPrefix  String
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model Sandbox {
  id           String          @id @default(uuid())
  userId       String
  language     SandboxLanguage
  status       SandboxStatus   @default(CREATING)
  containerId  String?
  port         Int?
  timeoutSecs  Int             @default(300)
  startedAt    DateTime?
  terminatedAt DateTime?
  createdAt    DateTime        @default(now())
  usageLogs    UsageLog[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model UsageLog {
  id           String   @id @default(uuid())
  sandboxId    String
  userId       String
  durationSecs Int
  billedAmount Float
  language     String
  createdAt    DateTime @default(now())
  sandbox      Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sandboxId])
  @@index([createdAt])
}

// Agent memory: persistent key-value store scoped by user + namespace
// namespace = agent role (architect, dev, qa, security, monitor, healer, shared)
model AgentMemory {
  id        String    @id @default(uuid())
  userId    String
  namespace String
  key       String
  value     String // JSON-encoded value
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, namespace, key])
  @@index([userId, namespace])
  @@index([expiresAt])
}

// Agent event log: immutable append-only decisions/actions record
model AgentEvent {
  id        String   @id @default(uuid())
  userId    String
  namespace String
  eventType String // e.g. "decision", "action", "observation", "error"
  payload   String // JSON-encoded
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, namespace])
  @@index([userId, createdAt])
}

enum CouncilStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// One council session = one task handed to the multi-agent panel
model CouncilSession {
  id        String           @id @default(uuid())
  userId    String
  task      String // The goal/problem statement
  context   String? // JSON — extra context (repo info, prior state, etc.)
  status    CouncilStatus    @default(PENDING)
  result    String? // JSON — synthesised final output
  errorMsg  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  CouncilMessage[]
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// Individual agent turn within a session
model CouncilMessage {
  id          String         @id @default(uuid())
  sessionId   String
  agentRole   String // architect | dev-1 | dev-2 | dev-3 | qa | security
  round       Int
  content     String // Full LLM response text
  inputTokens Int            @default(0)
  outTokens   Int            @default(0)
  createdAt   DateTime       @default(now())
  session     CouncilSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, round])
}

enum LoopRunStatus {
  RUNNING
  HEALTHY
  ISSUES_FOUND
  HEALED
  FAILED
}

// ── SERIAL 04: Detached Runtime Cloud ────────────────────────────────────────

enum RuntimeStatus {
  PROVISIONING
  RUNNING
  STOPPED
  CRASHED
  SLEEPING
  TERMINATED
}

enum RuntimeVisibility {
  PRIVATE
  PUBLIC
  PASSWORD
  TEAM
}

enum SleepState {
  AWAKE
  IDLE
  SLEEPING
  WAKING
}

// Persistent runtime registry — survives API restarts, creator disconnects
model RuntimeInstance {
  id              String            @id @default(uuid())
  projectId       String?
  workspaceId     String?
  ownerUserId     String
  runtimeType     String            @default("docker")
  containerId     String?
  previewUrl      String? // stable; never changes after first assignment
  internalPort    Int?
  externalPort    Int?
  status          RuntimeStatus     @default(PROVISIONING)
  visibility      RuntimeVisibility @default(PRIVATE)
  sleepState      SleepState        @default(AWAKE)
  recoveryCount   Int               @default(0)
  recoveryEvents  String? // JSON: [{at, reason, success}]
  passwordHash    String? // bcrypt hash for PASSWORD visibility
  metadata        String? // JSON: arbitrary runtime metadata
  allowRemix      Boolean           @default(false) // 06-07: opt-in remix
  sourceId        String? // 06-03: parent runtimeId for lineage
  remixNote       String? // 06-03: remix description / prompt delta
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastAccessAt    DateTime?
  lastHeartbeatAt DateTime?
  expiresAt       DateTime?

  @@index([projectId])
  @@index([workspaceId])
  @@index([ownerUserId])
  @@index([status])
  @@index([lastHeartbeatAt])
  @@index([status, lastHeartbeatAt])
  @@index([sourceId])
}

// ── SERIAL 06: Remix / Fork Engine ───────────────────────────────────────────

// 06-01: Fork ancestry — tracks every remix event
model ProjectFork {
  id                   String            @id @default(uuid())
  sourceProjectId      String?
  forkProjectId        String?
  sourceRuntimeId      String
  forkRuntimeId        String
  sourcePreviewRouteId String?
  forkPreviewRouteId   String?
  ownerUserId          String
  remixPrompt          String?
  visibility           RuntimeVisibility @default(PRIVATE)
  createdAt            DateTime          @default(now())

  @@index([sourceRuntimeId])
  @@index([forkRuntimeId])
  @@index([ownerUserId])
}

// ── SERIAL 07: Live AI Company Stream ────────────────────────────────────────

enum AgentType {
  PLANNER
  ARCHITECT
  FRONTEND
  BACKEND
  DATABASE
  QA
  DEVOPS
  SECURITY
  HEALER
  OBSERVER
}

enum EventStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum ActivitySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// 07-01: Persistent AI orchestration event stream
model AgentActivityEvent {
  id          String           @id @default(uuid())
  projectId   String?
  runtimeId   String?
  workspaceId String?
  agentType   AgentType
  eventType   String
  title       String
  message     String?
  metadata    String? // JSON — secrets stripped before persist
  severity    ActivitySeverity @default(INFO)
  status      EventStatus      @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  createdAt   DateTime         @default(now())

  @@index([projectId, createdAt])
  @@index([runtimeId, createdAt])
  @@index([agentType])
  @@index([createdAt])
  @@index([severity, createdAt])
}

// ── SERIAL 08: Persistent Snapshots + Recovery ───────────────────────────────

enum SnapshotType {
  MANUAL
  PRE_DEPLOY
  PRE_REMIX
  AUTO_RECOVERY
  SCHEDULED
}

enum SnapshotStatus {
  CREATING
  READY
  FAILED
  RESTORING
  RESTORED
  EXPIRED
}

enum RecoveryEventType {
  SNAPSHOT_CREATED
  RESTORE_STARTED
  RESTORE_SUCCEEDED
  RESTORE_FAILED
  RUNTIME_RECOVERED
  ROLLBACK_TRIGGERED
}

model ProjectSnapshot {
  id           String         @id @default(uuid())
  projectId    String?
  runtimeId    String?
  workspaceId  String?
  ownerUserId  String
  label        String?
  reason       String?
  snapshotType SnapshotType
  status       SnapshotStatus @default(CREATING)
  storagePath  String?
  manifest     String? // JSON — safe metadata only, secrets stripped
  checksum     String? // SHA-256 of manifest
  sizeBytes    Int?
  createdAt    DateTime       @default(now())
  restoredAt   DateTime?
  expiresAt    DateTime?

  recoveryEvents RuntimeRecoveryEvent[]

  @@index([projectId, createdAt])
  @@index([runtimeId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model RuntimeRecoveryEvent {
  id          String            @id @default(uuid())
  projectId   String?
  runtimeId   String?
  snapshotId  String?
  eventType   RecoveryEventType
  status      EventStatus
  reason      String?
  metadata    String? // JSON
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  snapshot ProjectSnapshot? @relation(fields: [snapshotId], references: [id])

  @@index([projectId, createdAt])
  @@index([runtimeId, createdAt])
  @@index([snapshotId])
  @@index([createdAt])
}

// ── SERIAL 05: Public Preview Gateway ────────────────────────────────────────

// 05-01: Slug-based aliases for stable preview URLs
model PreviewRoute {
  id           String            @id @default(uuid())
  runtimeId    String
  slug         String            @unique
  visibility   RuntimeVisibility @default(PRIVATE)
  passwordHash String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([runtimeId])
}

// 05-08: Privacy-safe access log (IP / UA stored as SHA-256 hashes)
model PreviewAccessLog {
  id         String   @id @default(uuid())
  runtimeId  String
  ipHash     String
  uaHash     String
  path       String   @default("/")
  statusCode Int      @default(200)
  createdAt  DateTime @default(now())

  @@index([runtimeId, createdAt])
  @@index([createdAt])
}

// User-registered continuous monitoring loop
model LoopConfig {
  id           String    @id @default(uuid())
  userId       String
  name         String
  description  String?
  intervalSecs Int       @default(3600)
  context      String? // JSON — what to monitor (repo, project, custom instructions)
  webhookUrl   String? // POST notifications on issues/heals
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  runs         LoopRun[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive, nextRunAt])
}

// One iteration of a loop
model LoopRun {
  id            String        @id @default(uuid())
  loopId        String
  status        LoopRunStatus @default(RUNNING)
  monitorOutput String? // JSON — monitor agent findings
  healerOutput  String? // JSON — healer agent actions
  issuesFound   Int           @default(0)
  issuesFixed   Int           @default(0)
  createdAt     DateTime      @default(now())
  completedAt   DateTime?
  config        LoopConfig    @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@index([loopId, createdAt])
  @@index([status])
}
